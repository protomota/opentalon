{
  "name": "opentalon-desktop",
  "productName": "OpenTalon",
  "version": "0.1.0",
  "private": true,
  "description": "An offline personal Kanban task manager with an embedded local MCP connector.",
  "author": "Protomota",
  "main": "electron/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "prototype": "npm run build && npm start",
    "package:mac": "node tools/package-mac.cjs",
    "release:mac": "node tools/package-mac.cjs --release",
    "test": "node --test electron/*.test.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.10.2",
    "electron-builder": "26.15.3",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "com.protomota.opentalon.prototype",
    "productName": "OpenTalon",
    "asar": true,
    "directories": {
      "output": "/Volumes/Expand/Codex Media/opentalon/prototype/release"
    },
    "files": [
      "electron/**/*",
      "!electron/*.test.cjs",
      "assets/opentalon-logo-1024.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": "Protomota, LLC (22HV69L32T)",
      "icon": "assets/opentalon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    }
  }
}
